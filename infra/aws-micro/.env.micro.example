# Env for the cheapest single-box AWS deployment (docker-compose.micro.yml).
# Copy to `.env` next to the compose file and fill in the CHANGE_ME values.
# On the EC2 box this lives at /opt/invoice-platform/.env (see cloud-init.yaml).

# --- Container image (must be pullable from the box) --------------------------
# Point this at a registry the box can reach: ECR, GHCR, or Docker Hub.
# e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com/invoice-platform-backend:<sha>
BACKEND_IMAGE=CHANGE_ME_REGISTRY/invoice-platform-backend:latest

APP_ENV=production

# --- Database (Postgres runs in a container on this same box) -----------------
POSTGRES_DB=invoice_platform
POSTGRES_USER=invoice_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://invoice_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/invoice_platform

# --- Redis (runs in a container on this same box) -----------------------------
REDIS_URL=redis://redis:6379/0

# --- Caddy reverse proxy (auto-HTTPS) — only needed if running docker-compose.caddy.yml
# Domain whose DNS A record points at this box; Caddy issues a Let's Encrypt cert for it.
API_DOMAIN=api.CHANGE_ME.com
ACME_EMAIL=CHANGE_ME@example.com

# --- Auth / CORS --------------------------------------------------------------
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# With Caddy in front, the API is served at https://${API_DOMAIN}. Point the
# frontend's VITE_API_BASE_URL there, and set CORS to the frontend's origin below.
# The CloudFront URL that serves your frontend (see frontend-deploy.sh output).
CORS_ALLOWED_ORIGINS=https://CHANGE_ME.cloudfront.net
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- AI providers (usage-based; billed by OpenAI/Google, not AWS) -------------
OPENAI_API_KEY=CHANGE_ME_OR_LEAVE_BLANK
OPENAI_EXTRACTION_MODEL=gpt-4.1
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-flash-latest

# --- Object storage -----------------------------------------------------------
# 'local' keeps invoice files on the EBS disk (cheapest, zero extra setup).
# Switch to 's3' + fill the keys/bucket to offload files to S3.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=invoice-platform
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
